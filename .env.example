# Server
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://myrouter:myrouter@localhost:5432/myrouter

# Provider credentials. Providers without a key are unavailable and may be skipped by fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: override the upstream model behind each public alias.
# OPENAI_MODEL_ID=gpt-4o
# ANTHROPIC_MODEL_ID=claude-sonnet-5
# GOOGLE_MODEL_ID=gemini-2.5-pro

# Optional: per-attempt timeouts in milliseconds.
# PROVIDER_TIMEOUT_MS=60000
# STREAM_FIRST_CHUNK_TIMEOUT_MS=30000
# STREAM_IDLE_TIMEOUT_MS=60000
